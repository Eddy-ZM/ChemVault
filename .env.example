# ChemVault website / Cloudflare Pages commercial MVP
# Do not commit real secret values. Configure production values in Cloudflare.

PUBLIC_APP_URL=http://localhost:8788

# Commercial runtime guard.
# Production must use ENVIRONMENT=production, COMMERCIAL_MODE=production,
# ENABLE_MOCK_BILLING=false and ENABLE_MOCK_AUTH=false.
ENVIRONMENT=development
COMMERCIAL_MODE=mock
ENABLE_MOCK_BILLING=true
ENABLE_MOCK_AUTH=true

# Payment placeholder. Supported production provider wiring is TODO.
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_TEAM_MONTHLY_PRICE_ID=
STRIPE_TEAM_YEARLY_PRICE_ID=

# Lead and newsletter routing placeholders.
ENTERPRISE_LEAD_EMAIL=
NEWSLETTER_PROVIDER=

# Server-side entitlement placeholder.
# The API defaults to Free. Use a real auth/session system before granting paid access.
DEFAULT_USER_PLAN=free
CHEMVAULT_ADMIN_TOKEN=

# Existing Cloudflare/D1 deployment variables.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CHEMVAULT_SITE_ORIGIN=https://chemvault.science
