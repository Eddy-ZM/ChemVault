# ChemVault website / Cloudflare Pages commercial MVP
# Do not commit real secret values. Configure production values in Cloudflare.

PUBLIC_APP_URL=http://localhost:8788

# Commercial runtime guard.
# Production must use ENVIRONMENT=production, COMMERCIAL_MODE=production,
# ENABLE_MOCK_BILLING=false and ENABLE_MOCK_AUTH=false.
ENVIRONMENT=development
COMMERCIAL_MODE=mock
ENABLE_MOCK_BILLING=true
ENABLE_MOCK_AUTH=true

# Payment placeholder. Supported production provider wiring is TODO.
PAYMENT_PROVIDER=placeholder
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PRO_MONTHLY_PRICE_ID=your_stripe_pro_monthly_price_id_here
STRIPE_PRO_YEARLY_PRICE_ID=your_stripe_pro_yearly_price_id_here
STRIPE_TEAM_MONTHLY_PRICE_ID=your_stripe_team_monthly_price_id_here
STRIPE_TEAM_YEARLY_PRICE_ID=your_stripe_team_yearly_price_id_here

# Lead and newsletter routing placeholders.
ENTERPRISE_LEAD_EMAIL=support@example.com
NEWSLETTER_PROVIDER=placeholder

# Server-side entitlement placeholder.
# The API defaults to Free. Use a real auth/session system before granting paid access.
DEFAULT_USER_PLAN=free
CHEMVAULT_ADMIN_TOKEN=replace_with_secure_token

# Existing Cloudflare/D1 deployment variables.
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_DATABASE_ID=your_cloudflare_database_id_here
CHEMVAULT_SITE_ORIGIN=https://chemvault.science
RESEND_API_KEY=your_resend_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
